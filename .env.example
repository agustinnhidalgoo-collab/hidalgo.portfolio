# ─── HIDALGO — variables de entorno ───────────────────────────────
# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local al repositorio.

# URL pública del sitio (para SEO, sitemap y enlaces absolutos)
SITE_URL=http://localhost:3000

# Base de datos (SQLite local por defecto; en producción, Turso: libsql://...)
DATABASE_URL=file:./data/hidalgo.db
# Solo necesario con Turso u otro libSQL remoto
DATABASE_AUTH_TOKEN=

# Carpeta donde se guardan imágenes, videos y PDFs subidos
MEDIA_DIR=./storage/media

# ─── Acceso al panel /admin ───
ADMIN_EMAIL=tu-email@ejemplo.com
# Generalo con:  npm run admin:hash -- "tu-contraseña"
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
