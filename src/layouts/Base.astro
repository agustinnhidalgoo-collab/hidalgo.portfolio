---
import '../styles/global.css';
import '../styles/zine.css';
import '../styles/story.css';
import antonUrl from '../assets/fonts/anton-latin-400-normal.woff2?url';
import interUrl from '../assets/fonts/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string; // ruta interna, p. ej. "/sobre-mi"
  ogImage?: string; // ruta en /public
  jsonLd?: Record<string, unknown>;
  robots?: string;
  world?: 'cellar' | 'barber' | 'aquarium';
}
const { title, description, path, ogImage = '/og.jpg', jsonLd, robots, world } = Astro.props;
const site = Astro.site; // solo existe si se define SITE_URL al compilar
const abs = (p: string) => (site ? new URL(p, site).toString() : undefined);
const canonical = abs(path);
// Polvo de la bodega: valores fijos (sin azar) para que la compilación sea siempre idéntica
const motes = Array.from({ length: 16 }, (_, i) => ({
  x: (i * 37 + 11) % 97,
  s: 3 + ((i * 5) % 7),
  d: -((i * 2.3) % 22),
  t: 20 + ((i * 7) % 15),
  dx: ((i * 13) % 11) - 5,
}));
const ogAbs = abs(ogImage);
---

<!doctype html>
<html lang="es" data-world={world}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={`${person.name} — Portfolio`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogAbs && <meta property="og:image" content={ogAbs} />}
    <meta name="twitter:card" content={ogAbs ? 'summary_large_image' : 'summary'} />
    <link rel="preload" as="font" type="font/woff2" href={antonUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          // Escena 3D solo en la home, con WebGL disponible y sin "reducir movimiento".
          if (!calm && (location.pathname === '/' || location.pathname === '/index.html')) {
            var c = document.createElement('canvas');
            var g = c.getContext('webgl2') || c.getContext('webgl');
            if (g) {
              d.classList.add('gl-try');
              var x = g.getExtension('WEBGL_lose_context');
              if (x) x.loseContext();
            }
          }
        } catch (e) {}
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={world ? 'has-world' : undefined}>
    <div class="world-bg" aria-hidden="true">
      <i data-w="cellar">{motes.map((m) => <b style={`--x:${m.x}%;--s:${m.s}px;--d:${m.d}s;--t:${m.t}s;--dx:${m.dx}vw`}></b>)}</i>
      <i data-w="barber"></i>
      <i data-w="aquarium"><u></u>{motes.slice(0, 12).map((m) => <b style={`--x:${m.x}%;--s:${Math.max(2, m.s - 3)}px;--d:${m.d * 1.6}s;--t:${m.t * 1.8}s;--dx:${m.dx * 0.6}vw`}></b>)}</i>
    </div>
    <div class="enter" id="enter" aria-hidden="true"><span class="enter__hand"></span><span class="display enter__title"></span><span class="enter__sub"></span></div>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <div class="progress" aria-hidden="true"></div>
    <Header current={path} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
