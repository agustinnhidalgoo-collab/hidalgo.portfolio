---
interface Props { dir?: 'left' | 'right' }
const { dir = 'left' } = Astro.props;
const words = ['Diseño gráfico', 'Identidad visual', 'Sistemas gráficos', 'Dirección de arte'];
const reps = [0, 1, 2, 3];
---

<div class="marquee" data-dir={dir} aria-hidden="true">
  <div class="marquee__track">
    {reps.map(() => <span>{words.map((w) => <>{w}<i> / </i></>)}</span>)}
  </div>
</div>
