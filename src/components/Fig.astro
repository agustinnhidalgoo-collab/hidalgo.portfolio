---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; label?: string; note?: string; caption?: string; eager?: boolean; sizes?: string }
const { src, alt, label, note, caption, eager = false, sizes } = Astro.props;
---

<figure class="fig reveal" style={`--nw:${src.width}`}>
  <Image src={src} alt={alt} format="webp" quality={88} loading={eager ? 'eager' : 'lazy'} decoding="async" sizes={sizes} />
  {(label || note || caption) && (
    <figcaption>
      {label && <span class="fk">{label}</span>}
      {note && <span>{note}</span>}
      {caption && <span>{caption}</span>}
    </figcaption>
  )}
</figure>
