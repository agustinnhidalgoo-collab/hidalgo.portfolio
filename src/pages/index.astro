---
import { Image } from 'astro:assets';
import ProjectStage from '../components/ProjectStage.astro';
import Skills from '../components/Skills.astro';
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import ProjectMeta from '../components/ProjectMeta.astro';
import avatar from '../assets/portrait/avatar.webp';
import avatarWink from '../assets/portrait/avatar-guino.webp';
import { person, contact, copy } from '../data/site';
import { getProjects, titleLines } from '../lib/projects';

const projects = await getProjects();
const description =
  'Portfolio de Agustín Hidalgo, diseñador y comunicador visual: identidades visuales, packaging y diseño editorial, del concepto a las aplicaciones. Proyectos, CV y contacto.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  email: contact.email,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Belgrano' },
  sameAs: [contact.instagramUrl],
};
const staged = projects.filter((p) => p.data.scene);
const others = projects.filter((p) => !p.data.scene);
const numOf = (p: (typeof projects)[number]) => projects.indexOf(p) + 1;
const pad = (n: number) => String(n).padStart(2, '0');
// «Sobre mí» de la portada: el párrafo se revela palabra por palabra con el scroll (las **negritas** se respetan)
const bio: { w: string; b: boolean; tight?: boolean }[] = [];
copy.lead.split('**').forEach((seg, i, all) => {
  // tramos pegados sin espacio entre medio («packaging**:»): la palabra anterior no lleva espacio detrás
  if (bio.length && seg && !/^\s/.test(seg) && !/\s$/.test(all[i - 1])) bio[bio.length - 1].tight = true;
  seg.split(/\s+/).filter(Boolean).forEach((w) => bio.push({ w, b: i % 2 === 1 }));
});
// Disciplinas que rotan junto a «Diseño de»
const crafts = ['Identidad', 'Packaging', 'Editorial', 'Marcas'];
// Índice lateral 01 / 02 de los mundos (nombre corto: «Cordero», «Be Fresh»)
const shortTitle = (p: (typeof projects)[number]) => p.data.short ?? (p.data.title.split(' ').length <= 2 ? p.data.title : p.data.title.split(' ')[0]);
const rail = staged.map((p) => ({ id: p.id, n: pad(numOf(p)), short: shortTitle(p), scene: p.data.scene }));
// Vista previa del índice: la pieza del primer mundo (con 3D, la botella se empieza a armar ahí)
const preview = staged[0]?.data.stageImages?.[0];
---

<Base title="Agustín Hidalgo — Portfolio de diseño gráfico" description={description} path="/" jsonLd={jsonLd}>
  <!-- Escena 3D (decorativa): halo de fondo + canvas. Todo el texto vive en el HTML. -->
  <div id="gl" class="gl" aria-hidden="true"><div class="gl__bg"></div><canvas></canvas></div>
  <!-- Rótulo del armado de la botella (decorativo): se muestra mientras el scroll la construye -->
  <div class="buildnote" aria-hidden="true" data-ph="0">
    <span class="buildnote__step"><b>01</b> Trazo</span>
    <span class="buildnote__step"><b>02</b> Volumen</span>
    <span class="buildnote__step"><b>03</b> Etiqueta</span>
    <i class="buildnote__bar"></i>
  </div>

  <!-- 1 · Portada: el avatar al centro, el saludo a la izquierda y lo que hago a la derecha.
       Al bajar (pantalla fijada) el texto se va, el avatar se corre a la izquierda y mira, y se despliega «Sobre mí». -->
  <section class="hero intro" id="inicio" aria-labelledby="hero-title">
    <div class="intro__pin">
      <div class="intro__stage wrap">
        <div class="intro__hello">
          <p class="intro__hi hand">Hola, soy</p>
          <h1 id="hero-title" class="display intro__name"><span>Agustín</span> <span>Hidalgo</span></h1>
        </div>
        <div class="intro__portrait" data-slot="portrait" data-wink>
          <Image class="slot__img" src={avatar} alt="Agustín Hidalgo en versión 3D, sonriendo" format="webp" quality={90} widths={[560, 1100]} sizes="(min-width: 64rem) 50vw, 100vw" loading="eager" fetchpriority="high" />
          <Image class="slot__img slot__img--wink" src={avatarWink} alt="" format="webp" quality={90} widths={[560, 1100]} sizes="(min-width: 64rem) 50vw, 100vw" loading="lazy" />
        </div>
        <div class="intro__role">
          <p class="intro__pre">Diseño de <span class="sr-only">{crafts.slice(0, -1).join(', ').toLowerCase()} y {crafts.at(-1)!.toLowerCase()}</span></p>
          <!-- Rueda de palabras: arriba la anterior (solo contorno), abajo la actual; la lista se repite para girar sin fin -->
          <div class="intro__words display" data-words aria-hidden="true">
            <div class="intro__wheel">{[...crafts, ...crafts, ...crafts].map((w) => <span>{w}</span>)}</div>
          </div>
        </div>
        <!-- Lugar del avatar cuando se despliega «Sobre mí» (la escena lo lleva hasta acá) -->
        <div class="intro__portrait-to" data-slot="portrait-about" data-wink-to aria-hidden="true"></div>
        <div class="intro__about" data-look>
          <p class="label intro__label">Sobre mí</p>
          <p class="intro__bio">{bio.map(({ w, b, tight }) => <>{b ? <strong class="w">{w}</strong> : <span class="w">{w}</span>}{tight ? '' : ' '}</>)}</p>
          <p class="intro__study">{copy.study}</p>
          <p class="intro__cta"><a class="btn btn--red" href="#trabajos">Ver proyectos <span class="arrow" aria-hidden="true">↓</span></a></p>
        </div>
        <p class="intro__cue" aria-hidden="true">Bajá <span>↓</span></p>
      </div>
    </div>
  </section>

  <!-- Habilidades: la botonera 3D, después de saber quién sos y antes de ver lo que hiciste -->
  <Skills />

  <!-- 2 · Trabajos: el índice es la pantalla central. La pieza del primer mundo empieza a armarse a la derecha -->
  <section class="works clear" id="trabajos" aria-labelledby="trabajos-title" data-snd-section>
    <div class="wrap grid works__grid">
      <div class="works__text">
        <p class="label">Portfolio</p>
        <h2 id="trabajos-title" class="display works__title mask"><span class="line"><span>Trabajos</span></span></h2>
        <ol class="works__list reveal">
          {projects.map((p) => (
            <li>
              <a href={p.data.scene ? `#stage-${p.data.scene}` : `/proyectos/${p.id}`} data-row={p.data.scene}>
                <span class="works__n" aria-hidden="true">{pad(numOf(p))}</span>
                <span class="works__t">{p.data.title}</span>
                <span class="works__d">{p.data.descriptor}{p.data.year && ` · ${p.data.year}`}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div class="works__preview" data-slot="preview" aria-hidden="true">
        {preview && <Image class="slot__img slot__img--shadow" src={preview.src} alt="" format="webp" quality={88} loading="lazy" sizes="(min-width: 64rem) 22vw, 50vw" />}
      </div>
    </div>
  </section>

  <!-- 3 · Un mundo por proyecto con 3D: una sola pantalla fijada; la pieza se arma al entrar -->
  {staged.map((p, i) => (
    <>
      <ProjectStage project={p} n={numOf(p)} rail={rail} />
      {/* Entre la bodega y la barbería: la botella estalla y el vino se vuelve la capa (lo dibuja la escena 3D).
          Tramo fijado sin texto: nada compite con la transformación. Sin 3D no existe. */}
      {p.data.scene === 'bottle' && staged[i + 1]?.data.scene === 'cape' && (
        <section class="burst" id="estallido" aria-hidden="true"><div class="burst__pin"></div></section>
      )}
    </>
  ))}

  <!-- Proyectos sin escena 3D: bloque editorial -->
  {others.length > 0 && (
    <div class="on-dark">
      {others.map((p) => (
        <article class="spread" aria-labelledby={`p-${p.id}`}>
          <div class="wrap grid">
            <div class="spread__text">
              <p class="label reveal">Proyecto {pad(numOf(p))}</p>
              <h3 id={`p-${p.id}`} class={`display ptitle mask ${p.data.titleTone === 'red' ? 'ptitle--red' : ''}`}>
                <a href={`/proyectos/${p.id}`}>
                  {titleLines(p).map((l, k) => <span class="line" style={`--i:${k}`}><span>{l}</span></span>)}
                </a>
              </h3>
              <p class="descriptor reveal">{p.data.descriptor}</p>
              <p class="prose reveal">{p.data.summary}</p>
              <div class="reveal"><ProjectMeta project={p} /></div>
              <a class="btn btn--red reveal" href={`/proyectos/${p.id}`}>
                Ver proyecto completo <span class="arrow" aria-hidden="true">→</span>
                <span class="sr-only">: {p.data.title}</span>
              </a>
            </div>
            <a class="spread__media" href={`/proyectos/${p.id}`} tabindex="-1" aria-hidden="true" data-cursor="Ver" data-clip>
              <Image src={p.data.cover.src} alt="" format="webp" quality={88} loading="lazy" data-parallax="5" sizes="(min-width: 64rem) 46vw, 100vw" />
            </a>
          </div>
        </article>
      ))}
    </div>
  )}

  <!-- 4 · Contacto -->
  <Contact stage />
</Base>
