---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Fig from '../components/Fig.astro';
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Marquee from '../components/Marquee.astro';
import ProjectMeta from '../components/ProjectMeta.astro';
import portrait from '../assets/portrait/agustin.png';
import { person, contact, cv, copy, cvData } from '../data/site';
import { getProjects, inline, titleLines } from '../lib/projects';

const projects = await getProjects();
const description =
  'Portfolio de Agustín Hidalgo, diseñador y comunicador visual: identidad visual, sistemas gráficos y dirección de arte. Proyectos, CV y contacto.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  email: contact.email,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Belgrano' },
  sameAs: [contact.instagramUrl],
};
const featured = cvData.experience.filter((e) => e.featured);
const stageProject = projects.find((p) => p.data.scene === 'bottle');
const others = projects.filter((p) => p !== stageProject);
const StageContent = stageProject ? (await render(stageProject)).Content : null;
const stageLinks = stageProject
  ? stageProject.data.sections.map((s, i) => ({ s, i })).filter(({ s }) => 'title' in s && s.title)
  : [];
const stagePalette = stageProject?.data.sections.find((s) => s.kind === 'palette');
const numOf = (p: (typeof projects)[number]) => projects.indexOf(p) + 1;
---

<Base title="Agustín Hidalgo — Portfolio de diseño gráfico" description={description} path="/" jsonLd={jsonLd}>
  <div id="gl" class="gl" aria-hidden="true"><canvas></canvas></div>

  <!-- 00 · Portada: el nombre como pieza 3D -->
  <section class="hero3d" id="inicio" aria-labelledby="hero-title">
    <div class="hero3d__stage">
      <h1 id="hero-title" class="hero3d__fb display"><span>Agustín</span><span>Hidalgo</span></h1>
      <span class="hero3d__note hero3d__note--a hand" aria-hidden="true">Diseño</span>
      <span class="hero3d__note hero3d__note--b hand" aria-hidden="true">Gráfico</span>
    </div>
    <div class="hero3d__foot wrap grid">
      <p class="hero3d__role"><span class="label">Portfolio · {person.year}</span>{person.role}. Identidad visual, sistemas gráficos y dirección de arte.</p>
      <nav class="hero3d__links" aria-label="Accesos de la portada">
        <a class="ulink" href="#proyectos">Proyectos</a>
        <a class="ulink" href="#contacto">Contacto</a>
        <a class="ulink" href={cv.href} download={cv.file}>CV</a>
      </nav>
    </div>
  </section>

  <!-- 01 · Introducción (el nombre se corre y deja lugar) -->
  <section class="sec clear intro3d" id="introduccion" aria-labelledby="introduccion-title">
    <div class="wrap">
      <div class="intro3d__col">
        <p class="eyebrow reveal">{contact.instagramHandle}</p>
        <h2 id="introduccion-title" class="display intro__title mask">
          <span class="line"><span>Introducción</span></span>
        </h2>
        <div class="intro__body prose reveal" style="--d:120ms">
          <p>
            {copy.intro.before}
            {copy.intro.marks.map((m, i) => (
              <>
                <mark class="pill">{m}</mark>{i === 0 ? ', ' : i === 1 ? ' y ' : '.'}
              </>
            ))}
            {' '}{copy.intro.paragraphs[0].text}<strong class="hl">{copy.intro.paragraphs[0].strong}</strong>
          </p>
          <p>{copy.intro.paragraphs[1].text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · Portfolio: apertura y acceso directo -->
  <section class="clear pindex" id="proyectos" aria-labelledby="proyectos-title">
    <div class="wrap">
      <h2 id="proyectos-title" class="display pindex__title mask"><span class="line"><span>Portfolio</span></span></h2>
      <div class="prose reveal">{copy.portfolio.map((p) => <p set:html={inline(p)} />)}</div>
      <ol class="pindex__list reveal">
        {projects.map((p, i) => (
          <li>
            <a href={p === stageProject ? '#cordero' : `/proyectos/${p.id}`}>
              <span class="pindex__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="pindex__t">{p.data.title}</span>
              <span class="pindex__d">{p.data.descriptor} · {p.data.year}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 · Proyecto con escena 3D: botella (tramo fijado breve, 3 pasos) -->
  {stageProject && (
    <section id="cordero" class="pstage clear" data-step="1" aria-labelledby={`p-${stageProject.id}`}>
      <div class="pstage__pin">
        <!-- Paso 1 · presentación -->
        <div class="pstage__step step-1">
          <div class="wrap grid step-grid">
            <div class="pstage__text">
              <p class="pnum" aria-hidden="true" style="margin-bottom:1.25rem"><span class="pnum__word">Project</span><span class="pnum__n">{numOf(stageProject)}</span></p>
              <h2 id={`p-${stageProject.id}`} class={`display ptitle ${stageProject.data.titleTone === 'red' ? 'ptitle--red' : ''}`}>
                {titleLines(stageProject).map((l) => <span style="display:block">{l}</span>)}
              </h2>
              <p class="descriptor" style="margin-top:1.5rem">{stageProject.data.descriptor}</p>
              <p class="prose" style="margin-top:1.25rem">{stageProject.data.summary}</p>
              <div style="margin-top:1.5rem"><ProjectMeta project={stageProject} /></div>
              <p style="margin-top:1rem"><a class="ulink" href={`/proyectos/${stageProject.id}`}>Ver proyecto <span class="arrow" aria-hidden="true">→</span><span class="sr-only">: {stageProject.data.title}</span></a></p>
            </div>
            <div class="pstage__cover" style="grid-column: 1 / -1; margin-top: 2rem">
              <Image src={stageProject.data.cover.src} alt={stageProject.data.cover.alt} format="webp" quality={88} loading="lazy" sizes="100vw" />
            </div>
          </div>
        </div>
        <!-- Paso 2 · concepto y detalle real de la etiqueta -->
        <div class="pstage__step step-2">
          <div class="wrap grid step-grid">
            <div class="pstage__text">
              <p class="label" style="margin-bottom:1rem">Contexto y concepto</p>
              <div class="lead">{StageContent && <StageContent />}</div>
            </div>
            <div class="pstage__photo">
              {stageProject.data.sections[0]?.kind === 'figure' && (
                <Fig src={stageProject.data.sections[0].image} alt={stageProject.data.sections[0].alt} caption="Detalle de la etiqueta" />
              )}
            </div>
          </div>
        </div>
        <!-- Paso 3 · hacia ilustración, textura, paleta y aplicaciones -->
        <div class="pstage__step step-3">
          <div class="wrap grid step-grid">
            <div class="pstage__text">
              <p class="label" style="margin-bottom:0.75rem">Dentro del proyecto</p>
              {stagePalette && stagePalette.kind === 'palette' && (
                <div class="pstage__swatches" role="list" aria-label="Paleta del proyecto">
                  {stagePalette.colors.map((c) => <i role="listitem" style={`background:${c.hex}`} title={c.hex.toUpperCase()}></i>)}
                </div>
              )}
              <ol class="pstage__links">
                {stageLinks.map(({ s, i }, k) => (
                  <li>
                    <a href={`/proyectos/${stageProject.id}#s-${i}`}>
                      <span class="k">{String(k + 1).padStart(2, '0')}</span>
                      <span class="t">{'title' in s ? s.title : ''}</span>
                      <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ol>
              <p style="margin-top:1.5rem"><a class="btn" href={`/proyectos/${stageProject.id}`}>Ver proyecto completo <span class="arrow" aria-hidden="true">→</span></a></p>
            </div>
          </div>
        </div>
        <div class="pstage__prog" aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
    </section>
    <div id="cordero-end" aria-hidden="true"></div>
  )}

  <!-- 04 · Resto de proyectos -->
  <div class="on-dark">
    {others.map((p) => {
      const lines = titleLines(p);
      return (
        <article class="spread" aria-labelledby={`p-${p.id}`}>
          <div class="wrap grid">
            <div class="spread__text">
              <p class="pnum reveal" aria-hidden="true">
                <span class="pnum__word">Project</span><span class="pnum__n">{numOf(p)}</span>
              </p>
              <h3 id={`p-${p.id}`} class={`display ptitle mask ${p.data.titleTone === 'red' ? 'ptitle--red' : ''}`}>
                <a href={`/proyectos/${p.id}`}>
                  {lines.map((l, k) => <span class="line" style={`--i:${k}`}><span>{l}</span></span>)}
                </a>
              </h3>
              <p class="descriptor reveal">{p.data.descriptor}</p>
              <p class="prose reveal">{p.data.summary}</p>
              <div class="reveal"><ProjectMeta project={p} /></div>
              <a class="ulink reveal" href={`/proyectos/${p.id}`}>
                Ver proyecto <span class="arrow" aria-hidden="true">→</span>
                <span class="sr-only">: {p.data.title}</span>
              </a>
            </div>
            <a class="spread__media" href={`/proyectos/${p.id}`} tabindex="-1" aria-hidden="true" data-cursor="Ver" data-clip>
              <Image src={p.data.cover.src} alt="" format="webp" quality={88} loading="lazy" data-parallax="5" sizes="(min-width: 64rem) 46vw, 100vw" />
            </a>
          </div>
        </article>
      );
    })}
  </div>

  <!-- 05 · Filosofía creativa (pausa luminosa) -->
  <section class="on-light" id="filosofia" aria-labelledby="filosofia-title">
    <div class="wrap manifesto-wrap">
      <h2 id="filosofia-title" class="sr-only">Filosofía creativa</h2>
      <p class="display manifesto" data-scrub aria-label={copy.manifesto.join(' ')}>
        {copy.manifesto.map((l, i) => (
          <span class="line" style={`--i:${i}`} aria-hidden="true"><span>{l}</span></span>
        ))}
      </p>
      <p class="manifesto-sig hand wipe" style="--d:500ms" aria-hidden="true">Agustín Hidalgo</p>
    </div>
  </section>

  <!-- 04 · Sobre mí -->
  <section class="sec on-dark about" id="sobre-mi" aria-labelledby="sobre-title" style="border-top: 1px solid var(--rule-dark)">
    <div class="wrap">
      <div class="grid">
        <div class="about__figure" data-clip>
          <Image src={portrait} alt="" format="webp" quality={90} widths={[520, 1040]} sizes="(min-width: 64rem) 40vw, 90vw" loading="lazy" />
        </div>
        <div class="about__text">
          <h2 id="sobre-title" class="display about__name mask" aria-label={person.name} data-drift="2">
            <span class="about__soy" aria-hidden="true">soy</span>
            <span class="line" style="--i:0" aria-hidden="true"><span>Agustin</span></span>
            <span class="line" style="--i:1" aria-hidden="true"><span>Hidalgo</span></span>
          </h2>
          <div class="prose reveal">
            {copy.about.map((p) => <p set:html={inline(p)} />)}
          </div>
          <div class="about__cta reveal">
            <a class="btn" data-magnetic href={cv.href} download={cv.file}>{cv.label} <span class="arrow" aria-hidden="true">↓</span></a>
            <a class="ulink" href="/sobre-mi">Sobre mí en detalle <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      <div class="cvgrid reveal">
        <div>
          <h3 class="label">Formación</h3>
          <p><strong>{cvData.education.title}</strong></p>
          <small>{cvData.education.org} · {cvData.education.period}</small>
        </div>
        <div>
          <h3 class="label">Experiencia</h3>
          <ul>
            {featured.map((e) => (
              <li>
                <strong>{e.role}</strong>
                <small>{e.org} · {e.period}</small>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="label">Herramientas</h3>
          <p>Adobe Illustrator, Adobe Photoshop, Google Workspace y Microsoft Office.</p>
          <small>Según CV.</small>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 · Contacto -->
  <Contact />
</Base>
