---
/* Página de proyecto, forma B: «mitad y mitad → ancho completo».
   La pieza del proyecto queda fija a la izquierda y reacciona a lo que se cuenta a la derecha (gira, se inclina,
   se numera). Las secciones con `layout: full` sueltan el mitad y mitad y pasan a ancho completo.
   No repite lo que ya mostró la home: sin resumen, sin «volver», sin índice. Cierra con el siguiente proyecto. */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import CaseBlock from '../../components/CaseBlock.astro';
import CaseVisual, { type Visual } from '../../components/CaseVisual.astro';
import Zine from '../../components/Zine.astro';
import { getProjects, titleLines, type Project } from '../../lib/projects';
import { person, contact } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], index: i },
  }));
}

interface Props { project: Project; next: Project; index: number }
const { project, next, index } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const lines = titleLines(project);
const tone = data.titleTone === 'red' ? 'ptitle--red' : '';
const title = data.seoTitle ?? `${data.title} — ${data.descriptor} · ${person.name}`;
const description = data.seoDescription ?? data.summary;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  creator: { '@type': 'Person', name: person.name },
  ...(data.year ? { dateCreated: String(data.year) } : {}),
  genre: [...(data.type ?? []), ...(data.category ?? [])],
};
const worldName = { cellar: 'Bodega', barber: 'Barbería', aquarium: 'Acuario' } as const;
const enterName = { cellar: 'a la bodega', barber: 'a la barbería', aquarium: 'al acuario' } as const;
const pad = (n: number) => String(n).padStart(2, '0');

/* ---------- Piezas de la columna fija y tramos ---------- */
type Section = Project['data']['sections'][number];
type Block = { s: Section; i: number; v: number; own: boolean };
type Run = { kind: 'split'; visuals: Visual[]; blocks: Block[]; first: boolean } | { kind: 'full'; s: Section; i: number };

/* Publicación (book): la página es un mundo (el acuario) que se recorre hojeando el libro; cierra con lo que demuestra.
   Las secciones arman su propio mitad y mitad a partir de la primera que trae pieza. */
const book = data.book;
const lead = data.stageImages?.[0];
const opening: Visual = lead
  ? { image: lead.src, alt: lead.alt, tilt: 0, cutout: true }
  : { image: data.cover.src, alt: data.cover.alt, tilt: 0, cutout: false };

const runs: Run[] = book ? [] : [{ kind: 'split', visuals: [opening], blocks: [], first: true }];
let carry: Visual | null = book ? null : opening;
data.sections.forEach((s, i) => {
  if (s.layout === 'full') {
    runs.push({ kind: 'full', s, i });
    return;
  }
  let run = runs[runs.length - 1];
  if (!run || run.kind !== 'split') {
    run = { kind: 'split', visuals: carry ? [carry] : [], blocks: [], first: false };
    runs.push(run);
  }
  let own: Visual | null = null;
  if (s.visual) own = { image: s.visual.image, alt: s.visual.alt, tilt: s.visual.tilt, note: s.visual.note, cutout: true };
  else if (s.kind === 'annotated')
    own = {
      image: s.image,
      alt: s.alt,
      tilt: 0,
      cutout: false,
      marks: s.notes.every((n) => n.x != null && n.y != null) ? s.notes.map((n) => ({ x: n.x!, y: n.y! })) : undefined,
    };
  if (own) {
    run.visuals.push(own);
    carry = own;
  }
  run.blocks.push({ s, i, v: Math.max(0, run.visuals.length - 1), own: !!own });
});

const nextLead = next.data.stageImages?.[0] ?? next.data.cover;
---

<Base title={title} description={description} path={`/proyectos/${project.id}`} jsonLd={jsonLd} world={data.world}>
  <article class={`case${book ? ' case--book' : ''}`} aria-labelledby="case-title">
    {book && (
      <>
        <!-- Publicación: un mundo, el acuario del relato. Se entra en la oscuridad, bajo una luz pálida -->
        <header class="aq-in">
          <div class="aq-in__light" aria-hidden="true"></div>
          <div class="wrap aq-in__in">
            <p class="label aq-in__k">{pad(index + 1)} · {data.descriptor}{data.year && ` · ${data.year}`}</p>
            <h1 id="case-title" class={`display ptitle aq-in__title mask ${tone}`}>
              {lines.map((l, k) => <span class="line" style={`--i:${k}`}><span>{l}</span></span>)}
            </h1>
            <p class="aq-in__lead reveal">{book.opening}</p>
            <p class="aq-in__down" aria-hidden="true">Entrá al acuario <span>↓</span></p>
          </div>
        </header>
        <section class="zr" data-zine-track style={`--states:${book.spreads.length}`} aria-label={`${data.title}: el fanzine, página por página`}>
          <div class="zr__pin" data-zine-pin>
            <Zine spreads={book.spreads} cover={book.cover} closing={book.closing} mode="case" name={data.title} />
          </div>
        </section>
        <!-- Cierre: qué demuestra la pieza y una invitación a hablar -->
        <section class="aq-pitch" aria-labelledby="pitch-title">
          <div class="wrap">
            <h2 id="pitch-title" class="display aq-pitch__t mask"><span class="line"><span>{book.pitch.title}</span></span></h2>
            <ul class="aq-pitch__list">
              {book.pitch.items.map((it, i) => (
                <li class="reveal" style={`--d:${i * 120}ms`}><span class="aq-pitch__n" aria-hidden="true">{pad(i + 1)}</span><strong>{it.t}</strong><span>{it.d}</span></li>
              ))}
            </ul>
            <div class="aq-pitch__cta reveal">
              <p>{book.pitch.cta}</p>
              <a class="btn btn--red" href={contact.whatsappUrl} target="_blank" rel="noopener noreferrer">Hablemos <span class="arrow" aria-hidden="true">→</span></a>
            </div>
            <div class="aq-pitch__meta reveal"><ProjectMeta project={project} /></div>
          </div>
        </section>
      </>
    )}
    {runs.map((run) =>
      run.kind === 'split' ? (
        <div class="cs-split" data-split>
          <!-- Columna fija (escritorio): la pieza cambia según la sección que se está leyendo -->
          <div class="cs-stage" aria-hidden="true">
            {run.visuals.map((v, k) => <CaseVisual v={v} k={k} decorative on={k === 0} eager={run.first && k === 0} />)}
          </div>
          <div class="cs-flow">
            {run.first && (
              <header class="cs-block cs-open" data-v="0">
                <div class="cs-inline"><CaseVisual v={opening} k={0} eager /></div>
                <p class="label cs-world">{pad(index + 1)}{data.world && ` · ${worldName[data.world]}`}</p>
                <h1 id="case-title" class={`display ptitle cs-title mask ${tone}`}>
                  {lines.map((l, k) => <span class="line" style={`--i:${k}`}><span>{l}</span></span>)}
                </h1>
                <p class="descriptor">{data.descriptor}</p>
                <ProjectMeta project={project} />
                <div class="cs-intro prose"><Content /></div>
                <p class="cs-down" aria-hidden="true">Bajá para recorrerlo <span>↓</span></p>
              </header>
            )}
            {run.blocks.map((b) => (
              <section class="cs-block" data-v={b.v} aria-labelledby={`s-${b.i + 1}`}>
                {b.own && <div class="cs-inline"><CaseVisual v={run.visuals[b.v]} k={b.v} /></div>}
                <CaseBlock s={b.s} i={b.i} />
              </section>
            ))}
          </div>
        </div>
      ) : (
        <section class="cs-full" aria-labelledby={`s-${run.i + 1}`}>
          <div class="wrap"><CaseBlock s={run.s} i={run.i} full /></div>
        </section>
      ),
    )}

    {data.links && data.links.length > 0 && (
      <section class="cs-full" aria-labelledby="links-title">
        <div class="wrap">
          <h2 id="links-title" class="display cs-h">Enlaces</h2>
          <ul>{data.links.map((l) => <li><a class="ulink" href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a></li>)}</ul>
        </div>
      </section>
    )}

    <!-- Cierre: un solo acceso. La pieza del siguiente mundo ya asoma -->
    {next.id !== project.id && (
      <a class="cs-next" href={`/proyectos/${next.id}`} data-world-next={next.data.world} data-cursor="Ir">
        <div class="wrap cs-next__in">
          <p class="label">
            Siguiente proyecto
            {next.data.world && <span class="hand cs-next__hand"> · entrando {enterName[next.data.world]}</span>}
          </p>
          <p class={`display cs-next__title ${next.data.titleTone === 'red' ? 'ptitle--red' : ''}`}>{next.data.title} <span class="arrow" aria-hidden="true">→</span></p>
        </div>
        <Image class="cs-next__img" src={nextLead.src} alt="" format="webp" quality={80} loading="lazy" sizes="40vw" />
      </a>
    )}
  </article>
</Base>

<script>
  /* Mitad y mitad: la sección que está en el centro de la pantalla elige la pieza fija; en la sección anotada,
     cada punto que se lee enciende su número. Sin JS (o sin IntersectionObserver) queda la primera pieza. */
  const center = { rootMargin: '-45% 0px -45% 0px' };
  if ('IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-split]').forEach((split) => {
      const vis = [...split.querySelectorAll<HTMLElement>('.cs-stage .cs-vis')];
      const show = (v: string) => vis.forEach((el) => el.toggleAttribute('data-on', el.dataset.v === v));
      const io = new IntersectionObserver((es) => {
        for (const e of es) if (e.isIntersecting) show((e.target as HTMLElement).dataset.v ?? '0');
      }, center);
      split.querySelectorAll<HTMLElement>('.cs-block').forEach((b) => io.observe(b));
    });
    const marks = [...document.querySelectorAll<HTMLElement>('.cs-vis__mark')];
    const io2 = new IntersectionObserver((es) => {
      for (const e of es) {
        if (!e.isIntersecting) continue;
        const n = Number((e.target as HTMLElement).dataset.note);
        marks.forEach((m) => m.classList.toggle('is-on', Number(m.dataset.mark) <= n));
        (e.target.parentElement?.querySelectorAll('[data-note]') ?? []).forEach((li) =>
          li.classList.toggle('is-on', Number((li as HTMLElement).dataset.note) <= n),
        );
      }
    }, center);
    document.querySelectorAll('.notes [data-note]').forEach((li) => io2.observe(li));
  }

  /* Tira de imágenes: con el mouse se arrastra (en táctil, teclado y trackpad ya se desplaza sola) */
  document.querySelectorAll<HTMLElement>('.strip').forEach((el) => {
    let x0 = 0, s0 = 0, moved = false;
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      x0 = e.clientX;
      s0 = el.scrollLeft;
      moved = false;
      el.setPointerCapture(e.pointerId);
      el.classList.add('is-drag');
    });
    el.addEventListener('pointermove', (e) => {
      if (!el.classList.contains('is-drag')) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 3) moved = true;
      el.scrollLeft = s0 - dx;
    });
    const end = () => el.classList.remove('is-drag');
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);
    // Un arrastre no cuenta como clic
    el.addEventListener('click', (e) => moved && e.preventDefault(), true);
  });
</script>
