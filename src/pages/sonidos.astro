---
import Base from '../layouts/Base.astro';
import { FOLEY } from '../data/sound-map';

const wine = ['cork', 'pour', 'glug', 'clink', 'scan'] as const;
const barber = ['cape-on', 'cape-flap', 'snip'] as const;
---

<Base title="Prueba de sonidos — Agustín Hidalgo" description="Página interna para escuchar los sonidos del portfolio." path="/sonidos" robots="noindex, nofollow">
  <section class="sec on-dark" style="padding-top: 7rem">
    <div class="wrap">
      <p class="label">Página interna · no está enlazada</p>
      <h1 class="display" style="font-size: clamp(3rem, 9vw, 8rem); margin-block: 0.5rem 1.5rem">Sonidos</h1>
      <p class="prose">
        Acá podés escuchar cada sonido antes de decidir. Son propios: están sintetizados con <code>scripts/make-sounds.py</code> (sin muestras de terceros),
        y todo se ajusta en <code>src/data/sound-map.ts</code>. En el sitio no hay sonidos de clic ni de hover: suena lo que pasa en escena.
      </p>
      <p style="margin-top: 1.5rem"><button class="btn" type="button" id="snd-start" data-no-sound>Activar audio de prueba</button></p>

      <h2 class="label" style="margin-top: 3rem">Bodega · vino</h2>
      <div class="snd-row">
        {wine.map((c) => <button class="btn btn--ghost snd-cue" type="button" data-cue={c} data-no-sound title={FOLEY[c].what}>{c}</button>)}
      </div>
      <p class="notice" style="margin-top: 1rem">{wine.map((c) => `${c}: ${FOLEY[c].what}`).join(' · ')}</p>

      <h2 class="label" style="margin-top: 3rem">Barbería · capa y tijera</h2>
      <div class="snd-row">
        {barber.map((c) => <button class="btn btn--ghost snd-cue" type="button" data-cue={c} data-no-sound title={FOLEY[c].what}>{c}</button>)}
      </div>
      <p class="notice" style="margin-top: 1rem">{barber.map((c) => `${c}: ${FOLEY[c].what}`).join(' · ')}</p>

      <h2 class="label" style="margin-top: 3rem">Ambientes (en bucle; el roce de la capa depende del scroll)</h2>
      <div class="snd-row">
        <button class="btn btn--ghost" type="button" data-world="studio" data-no-sound>Apertura (silencio)</button>
        <button class="btn btn--ghost" type="button" data-world="cellar" data-no-sound>Bodega</button>
        <button class="btn btn--ghost" type="button" data-world="barber" data-no-sound>Barbería</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .snd-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .snd-cue {
    min-height: 2.5rem;
    padding-inline: 0.9rem;
    letter-spacing: 0.04em;
  }
</style>

<script>
  import { setEnabled, play, setWorld } from '../scripts/sound';
  const start = document.getElementById('snd-start') as HTMLButtonElement;
  start.addEventListener('click', async () => {
    await setEnabled(true, { remember: false });
    start.textContent = 'Audio de prueba activo';
  });
  document.querySelectorAll<HTMLButtonElement>('.snd-cue').forEach((b) =>
    b.addEventListener('click', async () => {
      await setEnabled(true, { remember: false, silent: true });
      play(b.dataset.cue as never, { force: true });
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-world]').forEach((b) =>
    b.addEventListener('click', async () => {
      await setEnabled(true, { remember: false, silent: true });
      setWorld(b.dataset.world as 'studio' | 'cellar' | 'barber');
    }),
  );
</script>
